# --- BAZA (lokalno; v Dockerju jo postavi docker-compose) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/odvoz

# --- APLIKACIJA ---
# javni naslov (za povezavo do odjave v e-pošti)
APP_BASE_URL=http://localhost:3000
APP_PORT=3000

# --- docker-compose: postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=odvoz

# --- SMTP za pošiljanje obvestil (nodemailer) ---
SMTP_HOST=smtp.primer.si
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=uporabnik@primer.si
SMTP_PASS=geslo
SMTP_FROM="Koledar odvoza Smokuč <uporabnik@primer.si>"

# --- ZAŠČITA ZALEDJA (/admin) ---
# Če je nastavljeno, zaledje zahteva prijavo s tem geslom.
# Če je prazno ali izpuščeno, je zaledje odprto (priporočeno le lokalno).
ADMIN_PASSWORD=zamenjaj-me
# Neobvezno: ločen ključ za podpisovanje seje (sicer izpeljan iz gesla).
# Ob zamenjavi ključa se vse obstoječe seje odjavijo.
ADMIN_SECRET=

# --- zunanji cron (neobvezno) ---
CRON_SECRET=
